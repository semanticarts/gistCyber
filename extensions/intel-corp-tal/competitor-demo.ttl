@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix intel: <https://www.intelsecurity.com/ontology/intel-corp-tal#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/semanticarts/intel-corp-competitor-demo>
	a owl:Ontology ;
	owl:imports
		<https://w3id.org/semanticarts/ontology/gistBFO> ,
		<https://w3id.org/semanticarts/ontology/gistComputing> ,
		<https://w3id.org/semanticarts/ontology/gistCyber> ,
		<https://w3id.org/semanticarts/ontology/sdo-properties> ,
		<https://w3id.org/semanticarts/ontology/stix-properties> ,
		<https://w3id.org/semanticarts/ontology/vocabulary> ,
		<https://www.intelsecurity.com/ontology/intel-corp-tal>
		;
	skos:prefLabel "Intel Corp Competitor Demo"^^xsd:string ;
	.

intel:_TheatActor_Save_the_Snails
	a gist:ThreatActor ;
	gist:isCategorizedBy
		intel:_Access_external ,
		intel:_Limits_extraLegalMinor ,
		intel:_Motivation_organizationalGain
		;
	.

