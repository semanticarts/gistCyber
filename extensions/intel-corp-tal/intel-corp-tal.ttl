	rdfs:subClassOf intel:Hostile ;
	.

intel:Thief
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Vandal
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Vendor
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Visibility
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:_Access_external
	a intel:Access ;
	.

intel:_Access_internal
	a intel:Access ;
	.

intel:_Limits_codeOfConduct
	a intel:Limits ;
	.

intel:_Limits_extraLegalMajor
	a intel:Limits ;
	.

intel:_Limits_extraLegalMinor
	a intel:Limits ;
	.

intel:_Limits_legal
	a intel:Limits ;
	.

intel:_Motivation_accidental
	a intel:Motivation ;
