# imports: https://w3id.org/semanticarts/ontology/gistBFO
# imports: https://w3id.org/semanticarts/ontology/gistComputing
# imports: https://w3id.org/semanticarts/ontology/gistCyber
# imports: https://w3id.org/semanticarts/ontology/sdo-properties
# imports: https://w3id.org/semanticarts/ontology/stix-properties
# imports: https://w3id.org/semanticarts/ontology/vocabulary

@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix taint: <https://www.intelsecurity.com/ontology/intel-corp-tal#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.intelsecurity.com/ontology/intel-corp-tal>
	a owl:Ontology ;
	owl:imports
		<https://w3id.org/semanticarts/ontology/gistBFO> ,
		<https://w3id.org/semanticarts/ontology/gistComputing> ,
		<https://w3id.org/semanticarts/ontology/gistCyber> ,
		<https://w3id.org/semanticarts/ontology/sdo-properties> ,
		<https://w3id.org/semanticarts/ontology/stix-properties> ,
		<https://w3id.org/semanticarts/ontology/vocabulary>
		;
	skos:prefLabel "Intel Corp Threat Actor Library"^^xsd:string ;
	.

taint:Access
	a owl:Class ;
	rdfs:subClassOf taint:DefiningAttribute ;
	.

taint:Anarchist
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:CivilActivist
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:Competitor
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			gist:ThreatActor
			[
				a owl:Restriction ;
				owl:onProperty gist:isCategorizedBy ;
				owl:hasValue taint:_Access_external ;
			]
			[
				a owl:Restriction ;
				owl:onProperty gist:isCategorizedBy ;
				owl:hasValue taint:_Limits_extraLegalMinor ;
			]
			[
				a owl:Restriction ;
				owl:onProperty gist:isCategorizedBy ;
				owl:hasValue taint:_Motivation_organizationalGain ;
			]
		) ;
	] ;
	.

taint:CorruptGovernmentOfficial
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:DataMiner
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:DefiningAttribute
	a owl:Class ;
	rdfs:subClassOf gist:Category ;
	.

taint:EmployeeDisgruntled
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:EmployeeReckless
	a owl:Class ;
	rdfs:subClassOf taint:NonHostile ;
	.

taint:EmployeeUntrained
	a owl:Class ;
	rdfs:subClassOf taint:NonHostile ;
	.

taint:GovernmentCyberWarrior
	a owl:Class ;
