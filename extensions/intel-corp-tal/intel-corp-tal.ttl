# imports: https://w3id.org/semanticarts/ontology/gistBFO
# imports: https://w3id.org/semanticarts/ontology/gistComputing
# imports: https://w3id.org/semanticarts/ontology/gistCyber
# imports: https://w3id.org/semanticarts/ontology/sdo-properties
# imports: https://w3id.org/semanticarts/ontology/stix-properties
# imports: https://w3id.org/semanticarts/ontology/vocabulary

@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix intel: <https://www.intelsecurity.com/ontology/intel-corp-tal#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://www.intelsecurity.com/ontology/intel-corp-tal>
	a owl:Ontology ;
	owl:imports
		<https://w3id.org/semanticarts/ontology/gistBFO> ,
		<https://w3id.org/semanticarts/ontology/gistComputing> ,
		<https://w3id.org/semanticarts/ontology/gistCyber> ,
		<https://w3id.org/semanticarts/ontology/sdo-properties> ,
		<https://w3id.org/semanticarts/ontology/stix-properties> ,
		<https://w3id.org/semanticarts/ontology/vocabulary>
		;
	skos:prefLabel "Intel Corp Threat Actor Library"^^xsd:string ;
	.

intel:Access
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:Anarchist
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:CivilActivist
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Competitor
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	owl:equivalentClass [
		a owl:Class ;
		owl:intersectionOf (
			gist:ThreatActor
			[
				a owl:Restriction ;
				owl:onProperty gist:isCategorizedBy ;
				owl:hasValue intel:_Access_external ;
			]
			[
				a owl:Restriction ;
				owl:onProperty gist:isCategorizedBy ;
				owl:hasValue intel:_Limits_extraLegalMinor ;
			]
			[
				a owl:Restriction ;
				owl:onProperty gist:isCategorizedBy ;
				owl:hasValue intel:_Motivation_organizationalGain ;
			]
		) ;
	] ;
	.

intel:CorruptGovernmentOfficial
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:DataMiner
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:DefiningAttribute
	a owl:Class ;
	rdfs:subClassOf gist:Category ;
	.

intel:EmployeeDisgruntled
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:EmployeeReckless
	a owl:Class ;
	rdfs:subClassOf intel:NonHostile ;
	.

intel:EmployeeUntrained
	a owl:Class ;
	rdfs:subClassOf intel:NonHostile ;
	.

intel:GovernmentCyberWarrior
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:GovernmentSpy
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Hostile
	a owl:Class ;
	rdfs:subClassOf gist:ThreatActor ;
	.

intel:InfoPartner
	a owl:Class ;
	rdfs:subClassOf intel:NonHostile ;
	.

intel:InternalSpy
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:IrrationalIndividual
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:LegalAdversary
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Limits
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:Mobster
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Motivation
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:NonHostile
	a owl:Class ;
	rdfs:subClassOf gist:ThreatActor ;
	.

intel:Objective
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:Outcome
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:RadicalActivist
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Resources
	a owl:Class ;
	rdfs:subClassOf intel:DefiningAttribute ;
	.

intel:Sensationalist
	a owl:Class ;
	rdfs:subClassOf intel:Hostile ;
	.

intel:Skills
	a owl:Class ;
