	.

taint:GovernmentSpy
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:Hostile
	a owl:Class ;
	rdfs:subClassOf gist:ThreatActor ;
	.

taint:InfoPartner
	a owl:Class ;
	rdfs:subClassOf taint:NonHostile ;
	.

taint:InternalSpy
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:IrrationalIndividual
