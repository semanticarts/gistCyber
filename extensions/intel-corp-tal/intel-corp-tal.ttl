intel:_Motivation_coercion
	a intel:Motivation ;
	.

intel:_Motivation_disgruntlement
	a intel:Motivation ;
	.

intel:_Motivation_dominance
	a intel:Motivation ;
	skos:definition 'When applied to threat agents, the word "motivation" can have two meanings: cause, the reason a person commits an act, or drive, which describes the level of interest or intensity a person acts on. We use both meaning in our application of the Motivation parameter. Primarily, the Motivation parameter describes case, the emotional or situational reason the agent has taken a harmful action. However, those harmful actions may be unintentional, so the Motivation parameter does not necessarily signify hostile intent.'^^xsd:string ;
	skos:prefLabel "Motivation"^^xsd:string ;
	.

intel:_Motivation_ideology
	a intel:Motivation ;
	.

intel:_Motivation_notoriety
	a intel:Motivation ;
	.

intel:_Motivation_organizationalGain
