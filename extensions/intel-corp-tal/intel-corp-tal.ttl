	.

taint:Mobster
	a owl:Class ;
	rdfs:subClassOf taint:Hostile ;
	.

taint:Motivation
	a owl:Class ;
	rdfs:subClassOf taint:DefiningAttribute ;
	.

taint:NonHostile
	a owl:Class ;
	rdfs:subClassOf gist:ThreatActor ;
	.

taint:Objective
	a owl:Class ;
